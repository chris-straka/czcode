# Optional local settings for development. Nothing here is required: czcode has
# no hosted services, and devices reach machines over Tailscale.

# Reuse one web dev credential across worktrees (see docs/operations/development.md).
# CZ_DEV_AUTH_TOKEN=

# Optional mobile OpenTelemetry export to a collector you run yourself.
# CZ_MOBILE_OTLP_TRACES_URL=
# CZ_MOBILE_OTLP_TRACES_DATASET=
# CZ_MOBILE_OTLP_TRACES_TOKEN=
