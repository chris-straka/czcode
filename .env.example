# Optional: cz Connect source builds
# `cp .env.example .env` enables cz Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
CZ_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
CZ_CLERK_JWT_TEMPLATE=cz-relay
CZ_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in CZ_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# CZ_APPLE_TEAM_ID=ABC1234567
# CZ_MACOS_PROVISIONING_PROFILE=/absolute/path/to/czcode.provisionprofile
# CZ_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
CZ_RELAY_URL=https://relay.cz.ccez.uk

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.cz.ccez.uk; override to test against a staging deployment.
# CZ_HOSTED_APP_URL=https://nightly.app.cz.ccez.uk

# Public, ingest-only mobile OpenTelemetry configuration.
# CZ_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# CZ_MOBILE_OTLP_TRACES_DATASET=czcode-mobile-traces-dev
# CZ_MOBILE_OTLP_TRACES_TOKEN=xaat-...
